# Copy to terraform.tfvars (git-ignored) and replace the placeholders.
# In CI the same values are supplied as TF_VAR_* environment variables.

# Project and environment
project_name = "quizx"
environment  = "dev"
managedby    = "Terraform"

# AWS account and region
aws_region     = "eu-west-2"
aws_account_id = "<12-digit-account-id>"

# Execution role and bootstrap state (both created by infra/bootstrap)
terraform_execution_role_name = "quizx-dev-terraform-execution-role"
bootstrap_state_bucket_name   = "<state-bucket-name>"
bootstrap_state_file_key      = "<bootstrap-state-key>"

# Networking (optional: these are the defaults)
networking = {
  vpc_cidr             = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  availability_zones   = ["eu-west-2a", "eu-west-2b"]
  public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
  private_subnet_cidrs = ["10.0.3.0/24", "10.0.4.0/24"]
}

public_route_config = { cidr_block = "0.0.0.0/0" }

# External access. 203.0.113.10 is a documentation-only address: replace it
# with your own public IPv4 address as a /32.
access = {
  ssh_cidr          = "203.0.113.10/32"
  question_app_cidr = "203.0.113.10/32"
  submit_app_cidr   = "203.0.113.10/32"
}

service_ports = {
  ssh          = 22
  question_app = 4000
  submit_app   = 4200
  alb          = 80
  rds          = 3306
  vpc_link     = 80
}

# EC2 application servers (Ubuntu AMI)
instance_type  = "t3.micro"
aws_ami_id     = "ami-xxxxxxxxxxxxxxxxx"
ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"

# RDS
rds_master_password = "<strong-password>"

# Custom API domain (optional)
enable_custom_domain = false
domain_name          = "example.com"
api_subdomain        = "quizx"
