public_subnet_1_cidr = "10.0.1.0/24"
public_subnet_2_cidr = "10.0.2.0/24"

project_name        = "your-project-name"
aws_region          = "eu-west-2"
availability_zone_1 = "eu-west-2a"
availability_zone_2 = "eu-west-2b"

# Network configuration
vpc_cidr                 = "10.0.0.0/16"
vpc_enable_dns_support   = true
vpc_enable_dns_hostnames = true
public_route_config      = { cidr_block = "0.0.0.0/0" }

# Documentation-only TEST-NET address. Replace it with your trusted public
# IPv4 address and a /32 prefix before planning or applying.
allowed_ssh_cidr  = "203.0.113.10/32"
question_app_cidr = "203.0.113.10/32"
submit_app_cidr   = "203.0.113.10/32"

ssh_port          = 22
question_app_port = 4000
submit_app_port   = 4200

# Instance configuration
aws_ami_id     = "ami-xxxxxxxxxxxxxxxxx"
instance_type  = "t3.micro"
ec2_key_name   = "quizx-ec2-key-unique-name"
ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"

# Custom API domain. deploy.yml fixes these values to quizx.lecux.com.
enable_custom_domain = true
domain_name          = "lecux.com"
api_subdomain        = "quizx"
