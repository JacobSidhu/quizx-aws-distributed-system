PORT=4300
NODE_ENV=development

AWS_REGION=eu-west-2
SUBMITTED_QUESTIONS_QUEUE_NAME=quizx-dev-submit-app-queue
MODERATED_QUESTIONS_QUEUE_NAME=quizx-dev-moderate-queue
QUEUE_WAIT_TIME_SECONDS=20
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300

# Base URL of the Question App that serves GET /categories.
QUESTION_APP_BASE_URL=
CATEGORY_REQUEST_TIMEOUT_MS=3000

# Cognito user pool and app client that issue moderator access tokens.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_MODERATOR_GROUP=quizx-moderators

# Supply at runtime from a secret store. Use at least 32 characters.
REVIEW_TOKEN_SECRET=
